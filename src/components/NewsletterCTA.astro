---
import BriefForm from "@/components/BriefForm.astro";
const briefEnabled = import.meta.env.PUBLIC_BRIEF_ENABLED === "true";
---
<section class="newsletter" data-pagefind-ignore>
  <div>
    <div class="kicker">/ BRIEF</div>
    <h2>The second pass, in one email.</h2>
  </div>
  <p>
    The strongest technical changes, one useful chart, and one deeper read.
    No press-release rewrites.
  </p>
  {briefEnabled ? (
    <BriefForm source="homepage-cta" compact />
  ) : (
    <a href="/brief">OPEN / BRIEF</a>
  )}
</section>
