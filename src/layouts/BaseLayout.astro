---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE, siteUrl } from "@/lib/site";
import "katex/dist/katex.min.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  articleSection?: string;
  articleTags?: string[];
}
const {
  title,
  description = SITE.description,
  canonical = Astro.url.pathname,
  ogType = "website",
  image = "/og-default.svg",
  imageAlt,
  noindex = false,
  publishedTime,
  modifiedTime,
  articleSection,
  articleTags = []
} = Astro.props;

// Centralized prelaunch mode (fail-safe): prelaunch is the default.
// Only an explicit SITE_PRELAUNCH=false allows public indexing.
// Missing/undefined → prelaunch, "true" → prelaunch, "false" → public.
const prelaunch = import.meta.env.SITE_PRELAUNCH !== "false";
const shouldNoindex = noindex || prelaunch;
const fullTitle = title ? `${title} — ${SITE.plainName}` : `${SITE.name} — ${SITE.tagline}`;
const canonicalUrl = new URL(canonical, siteUrl()).toString();
const imageUrl = new URL(image, siteUrl()).toString();

// Determine OG image dimensions
const isOgPng = image.includes("/social/") && image.endsWith(".png");
const ogWidth = isOgPng ? "1200" : undefined;
const ogHeight = isOgPng ? "630" : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f2efe7" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.plainName} RSS`} href="/rss.xml" />
    {shouldNoindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {ogWidth && <meta property="og:image:width" content={ogWidth} />}
    {ogHeight && <meta property="og:image:height" content={ogHeight} />}

    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === "article" && articleSection && <meta property="article:section" content={articleSection} />}
    {ogType === "article" && articleTags.map(tag => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <slot name="head" />
  </head>
  <body data-analytics={import.meta.env.PUBLIC_ANALYTICS_ENABLED === "true" && !prelaunch ? "true" : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    {import.meta.env.PUBLIC_ANALYTICS_ENABLED === "true" && !prelaunch && (
      <script is:inline src="/_vercel/insights/script.js" defer></script>
    )}
  </body>
</html>
