---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE, siteUrl } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  image?: string;
  noindex?: boolean;
}
const {
  title,
  description = SITE.description,
  canonical = Astro.url.pathname,
  ogType = "website",
  image = "/og-default.svg",
  noindex = false
} = Astro.props;

// Centralized prelaunch mode (fail-safe): prelaunch is the default.
// Only an explicit SITE_PRELAUNCH=false allows public indexing.
// Missing/undefined → prelaunch, "true" → prelaunch, "false" → public.
const prelaunch = import.meta.env.SITE_PRELAUNCH !== "false";
const shouldNoindex = noindex || prelaunch;
const fullTitle = title ? `${title} — ${SITE.plainName}` : `${SITE.name} — ${SITE.tagline}`;
const canonicalUrl = new URL(canonical, siteUrl()).toString();
const imageUrl = new URL(image, siteUrl()).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f2efe7" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.plainName} RSS`} href="/rss.xml" />
    {shouldNoindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <slot name="head" />
  </head>
  <body data-analytics={import.meta.env.PUBLIC_ANALYTICS_ENABLED === "true" && !prelaunch ? "true" : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    {import.meta.env.PUBLIC_ANALYTICS_ENABLED === "true" && !prelaunch && (
      <script is:inline src="/_vercel/insights/script.js" defer></script>
    )}
  </body>
</html>
