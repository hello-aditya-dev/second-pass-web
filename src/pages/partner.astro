---
import BaseLayout from "@/layouts/BaseLayout.astro";
const formsEnabled = import.meta.env.PUBLIC_COMMERCIAL_FORMS_ENABLED === "true";
---
<BaseLayout title="/ PARTNER" description="Reach engineers and technical decision-makers without making the publication worse.">
  <section class="shell route">
    <header class="route-head">
      <div class="kicker">/ PARTNER</div>
      <h1>Reach engineers without making the publication worse.</h1>
      <p>
        SECOND / PASS reaches technical decision-makers who read carefully and
        value source-backed intelligence. Partnership preserves editorial integrity.
        Sponsor money never buys coverage, conclusions, or editorial review rights.
      </p>
    </header>

    <div class="partner-categories">
      <div class="partner-card">
        <div class="kicker">01</div>
        <h3>Founding Partner</h3>
        <p>Brand presence across the entire publication — header, / BRIEF, and / DATA surfaces.</p>
      </div>
      <div class="partner-card">
        <div class="kicker">02</div>
        <h3>/ BRIEF Partner</h3>
        <p>Dedicated placement in the technical briefing that subscribers actually read.</p>
      </div>
      <div class="partner-card">
        <div class="kicker">03</div>
        <h3>/ DATA Partner</h3>
        <p>Association with the reference products that engineers return to.</p>
      </div>
      <div class="partner-card">
        <div class="kicker">04</div>
        <h3>Selected Premium</h3>
        <p>Custom display in a specific section or format — one slot per surface.</p>
      </div>
    </div>

    {formsEnabled ? (
      <form class="commercial-form" id="partner-form" aria-label="Partner inquiry">
        <h2>Start a conversation</h2>

        <div class="form-row">
          <div class="form-field">
            <label for="partner-name">Name *</label>
            <input id="partner-name" name="name" type="text" required maxlength="120" autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="partner-company">Company *</label>
            <input id="partner-company" name="company" type="text" required maxlength="200" autocomplete="organization" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label for="partner-email">Work email *</label>
            <input id="partner-email" name="workEmail" type="email" required maxlength="254" autocomplete="email" />
          </div>
          <div class="form-field">
            <label for="partner-website">Website</label>
            <input id="partner-website" name="website" type="url" maxlength="500" autocomplete="url" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label for="partner-role">Role</label>
            <input id="partner-role" name="role" type="text" maxlength="120" />
          </div>
        </div>

        <div class="form-field">
          <label for="partner-objective">What are you looking to achieve? *</label>
          <textarea id="partner-objective" name="objective" required maxlength="1000" rows="3"></textarea>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label for="partner-budget">Budget range *</label>
            <select id="partner-budget" name="budgetRange" required>
              <option value="">Select</option>
              <option value="under-10k">Under $10K/mo</option>
              <option value="10k-25k">$10K–$25K/mo</option>
              <option value="25k-50k">$25K–$50K/mo</option>
              <option value="50k-100k">$50K–$100K/mo</option>
              <option value="100k+">$100K+/mo</option>
              <option value="custom">Custom package</option>
            </select>
          </div>
          <div class="form-field">
            <label for="partner-timing">Timeline *</label>
            <select id="partner-timing" name="timing" required>
              <option value="">Select</option>
              <option value="asap">As soon as possible</option>
              <option value="1-2-months">1–2 months</option>
              <option value="quarter">This quarter</option>
              <option value="exploring">Exploring options</option>
            </select>
          </div>
        </div>

        <div class="form-field">
          <label for="partner-message">Additional context</label>
          <textarea id="partner-message" name="message" maxlength="2000" rows="3"></textarea>
        </div>

        <input type="text" name="_hp" class="sr-only" tabindex={-1} autocomplete="off" aria-hidden="true" />

        <div class="form-actions">
          <button type="submit" class="form-submit">Submit inquiry</button>
          <div class="form-status" role="status" aria-live="polite"></div>
        </div>

        <p class="form-note">No fake traffic numbers, inflated reach claims, or mature-media rate cards. We'll respond with real placement options and audience composition.</p>
      </form>
    ) : (
      <div class="commercial-disabled">
        <p>Partner inquiries are not yet being accepted. When the notification system is connected, the form will appear here.</p>
      </div>
    )}
  </section>
</BaseLayout>

<script is:inline>
  document.getElementById('partner-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    const hp = form.querySelector('input[name="_hp"]');
    if (hp?.value) return;

    const fd = new FormData(form);
    const body = Object.fromEntries(fd.entries());
    body._hp = '';

    const btn = form.querySelector('.form-submit');
    const status = form.querySelector('.form-status');
    if (!btn || !status) return;
    btn.disabled = true;
    btn.textContent = 'Submitting…';
    status.textContent = '';

    try {
      const res = await fetch('/api/partner-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await res.json();
      if (res.ok) {
        status.textContent = data.message || 'Inquiry received.';
        status.className = 'form-status form-success';
        btn.textContent = '✓ Sent';
      } else {
        status.textContent = data.error || 'Something went wrong.';
        status.className = 'form-status form-error';
        btn.disabled = false;
        btn.textContent = 'Submit inquiry';
      }
    } catch {
      status.textContent = 'Network error. Please try again.';
      status.className = 'form-status form-error';
      btn.disabled = false;
      btn.textContent = 'Submit inquiry';
    }
  });
</script>

<style>
  .partner-categories {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin: 32px 0 48px;
  }
  .partner-card {
    border-top: 2px solid var(--ink);
    padding-top: 12px;
  }
  .partner-card h3 {
    margin: 6px 0 8px;
    font-size: 1.4rem;
    letter-spacing: -.03em;
  }
  .partner-card p {
    margin: 0;
    color: var(--graphite);
    font: .95rem/1.4 var(--reader);
  }
  .commercial-disabled {
    max-width: var(--reading);
    margin: 32px 0;
    font: 1.05rem/1.55 var(--reader);
    color: var(--graphite);
  }
  @media (max-width: 720px) {
    .partner-categories { grid-template-columns: 1fr; }
  }
</style>
