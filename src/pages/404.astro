---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="404" noindex={true}>
  <section class="shell route">
    <header class="route-head">
      <div class="kicker">404 / NOT FOUND</div>
      <h1>The first pass missed this one.</h1>
      <p>The page may have moved, changed, or never been published.</p>
    </header>
    <a class="mono" href="/">RETURN HOME →</a>
  </section>
</BaseLayout>
