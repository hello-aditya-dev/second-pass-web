---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="/ BRIEF" description="The Second Pass technical briefing.">
  <section class="shell route">
    <header class="route-head">
      <div class="kicker">/ BRIEF</div>
      <h1>The second pass, in one email.</h1>
      <p>
        One consequential development, three technical signals, one useful chart, and one deeper
        read. No newsletter provider is connected yet, so this page intentionally does not collect
        an email address.
      </p>
    </header>
    <div class="first-pass">
      <h2>PLANNED FORMAT</h2>
      <ul>
        <li>01 / The development that matters most</li>
        <li>02 / Three signals worth keeping</li>
        <li>03 / One chart or data update</li>
        <li>04 / One deeper piece worth the time</li>
      </ul>
    </div>
  </section>
</BaseLayout>
