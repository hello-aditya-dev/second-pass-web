---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BriefForm from "@/components/BriefForm.astro";
const briefEnabled = import.meta.env.PUBLIC_BRIEF_ENABLED === "true";
---
<BaseLayout title="/ BRIEF" description="The Second Pass technical briefing. One consequential development, three technical signals, one useful chart, and one deeper read.">
  <section class="shell route">
    <header class="route-head">
      <div class="kicker">/ BRIEF</div>
      <h1>The second pass, in one email.</h1>
      <p>
        The technical changes worth understanding. No press-release rewrites.
      </p>
    </header>

    {briefEnabled ? (
      <div class="brief-signup">
        <BriefForm source="brief-page" />
      </div>
    ) : (
      <div class="brief-prelaunch">
        <p>
          / BRIEF is not yet accepting signups. When the newsletter provider is connected,
          the subscription form will appear here.
        </p>
      </div>
    )}

    <div class="first-pass">
      <h2>FORMAT</h2>
      <ul>
        <li>01 / The development that matters most this cycle</li>
        <li>02 / Three signals worth keeping — changes that didn't make the first headline</li>
        <li>03 / One chart or data update from / DATA</li>
        <li>04 / One deeper piece from / SECOND PASS worth the time</li>
      </ul>
    </div>

    <div class="brief-consent-note">
      <p>
        By subscribing, you agree to receive SECOND / PASS / BRIEF by email.
        You can unsubscribe at any time via the link in each email.
        <a href="/privacy">Privacy</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .brief-signup {
    max-width: var(--reading);
    margin: 32px 0 48px;
    padding: 32px;
    border: 1px solid var(--rule);
    background: var(--paper-2, #e9e4d9);
  }
  .brief-prelaunch {
    max-width: var(--reading);
    margin: 32px 0 48px;
    font: 1.05rem/1.55 var(--reader);
    color: var(--graphite);
  }
  .brief-consent-note {
    max-width: var(--reading);
    margin-top: 48px;
    font: .82rem/1.4 var(--reader);
    color: var(--graphite);
  }
  .brief-consent-note a { color: var(--blue-dark); }
</style>
