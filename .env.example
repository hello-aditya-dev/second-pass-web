# ── Site ──
PUBLIC_SITE_URL=https://second-pass.vercel.app
SITE_PRELAUNCH=true

# ── Prelaunch mode (fail-safe) ──
# Prelaunch is the DEFAULT. If missing or "true", the site is noindex/nofollow
# and robots.txt serves Disallow: /. Analytics is disabled.
# Only an explicit SITE_PRELAUNCH=false allows public indexing.
#   missing → PRELAUNCH   |   true → PRELAUNCH   |   false → PUBLIC
#
# CRITICAL — VERCEL PRODUCTION ACTION REQUIRED:
# For the production deployment to be publicly indexable, you MUST set
# SITE_PRELAUNCH=false in the Vercel project Environment Variables
# (Settings → Environment Variables → Production).
# Do NOT rely on a committed .env file for this — Vercel uses its own
# environment variables. The .env file is gitignored and local-only.
SITE_PRELAUNCH=true

# ── Beehiiv (BRIEF newsletter) ──
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_NEWSLETTER_LIST_ID=

# ── Resend (lead notifications) ──
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_BACKUP_EMAIL=
LEADS_FROM_EMAIL=

# ── Contact ──
PUBLIC_CONTACT_EMAIL=

# ── Feature toggles ──
PUBLIC_BRIEF_ENABLED=false
PUBLIC_COMMERCIAL_FORMS_ENABLED=false
PUBLIC_ANALYTICS_ENABLED=false

# ── Author social profiles (optional, add when available) ──
# PUBLIC_AUTHOR_TWITTER=
# PUBLIC_AUTHOR_LINKEDIN=
# PUBLIC_AUTHOR_GITHUB=
