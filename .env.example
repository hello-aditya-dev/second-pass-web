# ── Site ──
PUBLIC_SITE_URL=https://second-pass.vercel.app

# ── Prelaunch mode ──
# When true: all pages emit noindex,nofollow; robots.txt Disallow: /;
# analytics disabled; homepage remains accessible for QA.
# Set to false when ready for public indexing.
SITE_PRELAUNCH=true

# ── Beehiiv (BRIEF newsletter) ──
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_NEWSLETTER_LIST_ID=

# ── Resend (lead notifications) ──
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_BACKUP_EMAIL=
LEADS_FROM_EMAIL=

# ── Contact ──
PUBLIC_CONTACT_EMAIL=

# ── Feature toggles ──
PUBLIC_BRIEF_ENABLED=false
PUBLIC_COMMERCIAL_FORMS_ENABLED=false
PUBLIC_ANALYTICS_ENABLED=false
