# ── Site ──
PUBLIC_SITE_URL=https://second-pass.vercel.app

# ── Prelaunch mode (fail-safe) ──
# Prelaunch is the DEFAULT. If missing or "true", the site is noindex/nofollow
# and robots.txt serves Disallow: /. Analytics is disabled.
# Only an explicit SITE_PRELAUNCH=false allows public indexing.
#   missing → PRELAUNCH   |   true → PRELAUNCH   |   false → PUBLIC
SITE_PRELAUNCH=true

# ── Beehiiv (BRIEF newsletter) ──
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_NEWSLETTER_LIST_ID=

# ── Resend (lead notifications) ──
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_BACKUP_EMAIL=
LEADS_FROM_EMAIL=

# ── Contact ──
PUBLIC_CONTACT_EMAIL=

# ── Feature toggles ──
PUBLIC_BRIEF_ENABLED=false
PUBLIC_COMMERCIAL_FORMS_ENABLED=false
PUBLIC_ANALYTICS_ENABLED=false
