---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Pre-launch privacy notice." description="This foundation does not currently use an analytics provider, advertising provider, account system,">
  <section class="shell route">
    <header class="route-head">
      <div class="kicker">/ PRIVACY</div>
      <h1>Pre-launch privacy notice.</h1>
    </header>
    <div style="max-width:var(--reading);font:1.18rem/1.65 var(--reader)">
      <p>This foundation does not currently use an analytics provider, advertising provider, account system,
or newsletter collection service.</p>
<p>Before any such system is enabled, this notice must be updated to describe the site's actual data
collection and the consent or control mechanisms that apply.</p>
    </div>
  </section>
</BaseLayout>
