{
  "name": "second-pass-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 -p 3000 2>&1 | tee dev.log",
    "build:astro": "astro build",
    "search:index": "node scripts/build-search.mjs",
    "build": "bun run build:astro && bun run search:index",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "bun run check && bun run build",
    "article:new": "node scripts/new-article.mjs",
    "article:verify": "node scripts/verify-article.mjs",
    "content:audit": "node scripts/content-audit.mjs",
    "social:generate": "node scripts/generate-social-assets.mjs",
    "social:generate:all": "node scripts/generate-social-assets.mjs --all",
    "favicons:generate": "node scripts/generate-favicons.mjs",
    "distribute:url": "node scripts/distribute-url.mjs",
    "launch:verify": "node scripts/launch-verify.mjs",
    "render-audit": "node scripts/render-audit.mjs",
    "content-source-audit": "node scripts/content-source-audit.mjs",
    "currency-regression": "node scripts/currency-regression-test.mjs",
    "responsive:audit": "node scripts/responsive-audit.mjs",
    "visual:audit": "node scripts/visual-audit.mjs",
    "prepublish": "node scripts/prepublish.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/vercel": "^11.0.5",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/newsreader": "^5.2.10",
    "astro": "7.1.6",
    "katex": "^0.18.3",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "^1.62.1",
    "pagefind": "1.5.2",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.2.19",
  "engines": {
    "node": "24.x"
  }
